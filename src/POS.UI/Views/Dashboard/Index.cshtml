@{
    ViewData["Title"] = "Dashboard Gerencial";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Tablero de Control Fiscal</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Ley 32-23</span>
        </div>
        <p class="text-muted small mb-0">Monitoreo y trazabilidad de comprobantes fiscales e-CF transmitidos a la DGII</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Pos" asp-action="Index" class="btn btn-success fw-bold d-flex align-items-center gap-2 shadow-sm px-3">
            <i class="bi bi-cart3"></i>Abrir Terminal POS (F4)
        </a>
        <a asp-controller="Facturacion" asp-action="Emitir" class="btn btn-outline-primary fw-semibold d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i>Emitir e-CF Manual
        </a>
    </div>
</div>

<!-- Tarjetas Métricas KPI -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card metric-card-emerald">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Aceptados DGII</span>
                    <h2 class="fw-bold text-success font-tabular my-1">@ViewBag.AceptadosCount</h2>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">
                        <i class="bi bi-check-all me-1"></i>Conformes eNCF
                    </span>
                </div>
                <div class="p-3 rounded-circle" style="background-color: #ecfdf5; color: #059669;">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card metric-card-amber">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">En Proceso / Polling</span>
                    <h2 class="fw-bold text-warning font-tabular my-1">@ViewBag.EnProcesoCount</h2>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.7rem;">
                        <i class="bi bi-hourglass-split me-1"></i>TrackId Pendiente
                    </span>
                </div>
                <div class="p-3 rounded-circle" style="background-color: #fffbeb; color: #d97706;">
                    <i class="bi bi-cloud-arrow-up fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card metric-card-purple">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Contingencia RFCE</span>
                    <h2 class="fw-bold text-dark font-tabular my-1">@ViewBag.ContingenciaCount</h2>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.7rem;">
                        <i class="bi bi-hdd-network me-1"></i>En Cola Local
                    </span>
                </div>
                <div class="p-3 rounded-circle" style="background-color: #f3e8ff; color: #7c3aed;">
                    <i class="bi bi-cloud-slash fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card metric-card-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Rechazados DGII</span>
                    <h2 class="fw-bold text-danger font-tabular my-1">@ViewBag.RechazadosCount</h2>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.7rem;">
                        <i class="bi bi-exclamation-octagon me-1"></i>Requiere Revisión
                    </span>
                </div>
                <div class="p-3 rounded-circle" style="background-color: #fee2e2; color: #dc2626;">
                    <i class="bi bi-x-octagon fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Accesos Rápidos y Tipos de Comprobantes Soportados -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-slate-800 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3 text-primary"></i>
                Esquemas Fiscales Soportados por PosPalasy
            </h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 rounded-3 border bg-light h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-primary">e-CF 31</span>
                            <i class="bi bi-buildings text-primary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Crédito Fiscal</h6>
                        <p class="text-muted small mb-0">Para transacciones entre empresas contribuyentes con crédito de ITBIS y deducción de ISR.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 border bg-light h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-success">e-CF 32</span>
                            <i class="bi bi-person-check text-success fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Consumo Final</h6>
                        <p class="text-muted small mb-0">Comprobante principal para ventas del punto de venta a clientes particulares y mostrador.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 border bg-light h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-secondary">RFCE 32</span>
                            <i class="bi bi-wifi-off text-secondary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Contingencia Offline</h6>
                        <p class="text-muted small mb-0">Almacenamiento seguro en disco ante interrupciones de conectividad con transmisión automática.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-slate-800 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-lightning-charge text-warning"></i>
                Operaciones Rápidas
            </h5>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Pos" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3 rounded-3 hover-shadow">
                    <div>
                        <div class="fw-bold text-dark"><i class="bi bi-cart3 text-primary me-2"></i>Ir a Caja Terminal</div>
                        <small class="text-muted">Cobro táctil con cálculo de ITBIS</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-controller="Caja" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3 rounded-3 hover-shadow">
                    <div>
                        <div class="fw-bold text-dark"><i class="bi bi-safe text-success me-2"></i>Turnos y Arqueo de Caja</div>
                        <small class="text-muted">Corte X y Reporte Z del turno</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-controller="Reportes" asp-action="Ventas607" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3 rounded-3 hover-shadow">
                    <div>
                        <div class="fw-bold text-dark"><i class="bi bi-file-earmark-spreadsheet text-info me-2"></i>Libro de Ventas 607</div>
                        <small class="text-muted">Generación mensual para DGII</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>
