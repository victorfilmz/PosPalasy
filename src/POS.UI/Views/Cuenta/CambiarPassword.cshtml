@model POS.UI.Models.CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="container-fluid px-4 py-3" style="max-width: 720px;">
    <h4 class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock me-2 text-primary"></i>Cambio de contraseña</h4>
    <p class="text-muted small">La contraseña es personal e intransferible. No la comparta ni la reutilice en otros sistemas.</p>

    @if (Model.EsObligatorio)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>Cambio obligatorio.</strong> Esta cuenta fue creada con una contraseña temporal generada por el sistema.
                Debe definir una contraseña propia antes de poder operar.
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="CambiarPassword" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="PasswordActual" class="form-label fw-bold small text-slate-700"></label>
                    <input asp-for="PasswordActual" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordNueva" class="form-label fw-bold small text-slate-700"></label>
                    <input asp-for="PasswordNueva" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="PasswordNueva" class="text-danger small"></span>
                    <div class="form-text">
                        Mínimo @POS.Application.Validators.PasswordPolicy.LongitudMinima caracteres, con mayúscula, minúscula,
                        dígito y carácter especial. No puede contener el nombre de usuario.
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarPassword" class="form-label fw-bold small text-slate-700"></label>
                    <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary fw-bold px-4">
                    <i class="bi bi-check2-circle me-2"></i>Actualizar contraseña
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
