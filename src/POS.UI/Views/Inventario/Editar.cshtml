@model POS.Application.DTOs.EditarProductoDto
@using POS.Domain.Types

@{
    ViewData["Title"] = "Editar Producto de Inventario";
    var categorias = ViewBag.CategoriasExistentes as List<string> ?? new List<string>();
    var stockActual = (decimal)(ViewBag.StockActual ?? 0m);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-light border text-muted"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold text-dark mb-0">Editar Producto</h3>
            <span class="badge bg-light text-dark border">ID #@Model.Id</span>
        </div>
        <p class="text-muted small mb-0 ps-4 ms-2">Modifique precios, datos comerciales o estado del producto en el catálogo</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Kardex" asp-route-productoId="@Model.Id" class="btn btn-outline-secondary fw-semibold">
            <i class="bi bi-clock-history me-1"></i>Ver Kardex
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
            <i class="bi bi-x-circle me-1"></i>Cancelar
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-pencil me-2 text-primary"></i>Actualización de Ficha</h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Existencia Actual:</span>
                    <span class="badge @(stockActual <= 0 ? "bg-danger" : (stockActual <= Model.StockMinimo ? "bg-warning text-dark" : "bg-success")) px-2 py-1 fs-6 font-monospace">
                        @stockActual.ToString("0.##") unids
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post" id="formEditar">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row g-3">
                        
                        <!-- Código -->
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-slate-700">Código / SKU</label>
                            <input type="text" name="Codigo" value="@Model.Codigo" class="form-control font-monospace fw-bold" required />
                        </div>

                        <!-- Categoría -->
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-slate-700">Categoría</label>
                            <input list="listaCategorias" name="Categoria" value="@Model.Categoria" class="form-control" required />
                            <datalist id="listaCategorias">
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat"></option>
                                }
                            </datalist>
                        </div>

                        <!-- Nombre / Descripción -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-slate-700">Nombre / Descripción Comercial</label>
                            <input type="text" name="Descripcion" value="@Model.Descripcion" class="form-control fw-semibold" required />
                        </div>

                        <!-- Indicador Fiscal DGII -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Indicador Fiscal DGII (ITBIS)</label>
                            <select name="IndicadorFacturacion" class="form-select">
                                <option value="1" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.ITBIS1_18)">Gravado 18% (Tasa general)</option>
                                <option value="2" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.ITBIS2_16)">Gravado 16% (Reducido)</option>
                                <option value="4" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.Exento)">Exento de ITBIS (0%)</option>
                            </select>
                        </div>

                        <!-- Estado Activo Switch -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Disponibilidad en Catálogo</label>
                            <div class="form-check form-switch p-2 bg-light rounded border">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="switchActivo" name="EstaActivo" value="true" @(Model.EstaActivo ? "checked" : "") />
                                <label class="form-check-label small fw-semibold" for="switchActivo">
                                    Producto Activo (Visible en Punto de Venta)
                                </label>
                            </div>
                        </div>

                        <!-- Precios y Costos -->
                        <div class="col-12 pt-3 border-top">
                            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-tag me-2 text-primary"></i>Precios y Rentabilidad</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Costo Unitario de Compra (RD$)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">RD$</span>
                                <input type="number" step="0.01" min="0" name="CostoUnitario" id="inputCosto" value="@Model.CostoUnitario" class="form-control font-monospace" oninput="calcularMargen()" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Precio de Venta al Público (RD$)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-primary">RD$</span>
                                <input type="number" step="0.01" min="0.01" name="PrecioUnitario" id="inputPrecio" value="@Model.PrecioUnitario" class="form-control font-monospace fw-bold fs-5 text-primary" oninput="calcularMargen()" required />
                            </div>
                        </div>

                        <!-- Widget de Margen en Vivo -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-semibold">Rentabilidad Estimada:</span>
                                    <div class="fw-bold" id="labelGanancia">RD$ 0.00 de ganancia bruta</div>
                                </div>
                                <span class="badge bg-secondary px-3 py-2 fs-6" id="badgeMargen">0% Margen</span>
                            </div>
                        </div>

                        <!-- Umbral de Alerta -->
                        <div class="col-12 pt-3 border-top">
                            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-bell me-2 text-primary"></i>Configuración de Alertas</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Stock Mínimo de Alerta</label>
                            <input type="number" step="0.01" min="0" name="StockMinimo" value="@Model.StockMinimo" class="form-control font-monospace" required />
                            <small class="text-muted">Si la existencia cae por debajo de este valor, se alertará en color ámbar</small>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-bold px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i>Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-light border px-4 py-2">Cancelar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calcularMargen() {
            const costo = parseFloat(document.getElementById('inputCosto').value) || 0;
            const precio = parseFloat(document.getElementById('inputPrecio').value) || 0;
            const badge = document.getElementById('badgeMargen');
            const label = document.getElementById('labelGanancia');

            const ganancia = precio - costo;
            label.innerText = `RD$ ${ganancia.toFixed(2)} de ganancia bruta por unidad`;

            if (costo > 0) {
                const margen = ((ganancia / costo) * 100).toFixed(1);
                badge.innerText = `+${margen}% Margen`;
                if (margen >= 30) {
                    badge.className = 'badge bg-success px-3 py-2 fs-6';
                } else if (margen > 0) {
                    badge.className = 'badge bg-warning text-dark px-3 py-2 fs-6';
                } else {
                    badge.className = 'badge bg-danger px-3 py-2 fs-6';
                }
            } else {
                badge.innerText = `100% Margen`;
                badge.className = 'badge bg-primary px-3 py-2 fs-6';
            }
        }

        document.addEventListener('DOMContentLoaded', calcularMargen);
    </script>
}
