@model IEnumerable<POS.Application.DTOs.ProductoInventarioDto>
@using POS.Domain.Entities
@using POS.Domain.Types
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Inventario y Catálogo de Productos";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var filtroQuery = ViewBag.FiltroQuery as string ?? "";
    var filtroCategoria = ViewBag.FiltroCategoria as string ?? "";
    var filtroEstado = ViewBag.FiltroEstado as string ?? "";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    var sucursalSeleccionadaId = ViewBag.SucursalSeleccionadaId as int? ?? 1;
    var nombreSucursalActual = ViewBag.NombreSucursalActual as string ?? "Sucursal Principal";
}

<!-- Encabezado y Acciones Principales -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Gestión de Inventario y Productos</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Control de Existencias</span>
        </div>
        <p class="text-muted small mb-0">Administre su catálogo comercial, códigos de barras, márgenes de ganancia y existencias en tiempo real</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Kardex" class="btn btn-outline-secondary fw-semibold d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-clock-history"></i>Auditoría Kardex
        </a>
        <a asp-action="Crear" class="btn btn-primary fw-bold d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i>Nuevo Producto
        </a>
    </div>
</div>

<!-- Tarjetas de Métricas de Inventario -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Catálogo Total</span>
                    <h4 class="fw-bold mb-0 text-slate-800">@ViewBag.TotalProductos <span class="fs-6 fw-normal text-muted">items</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Valor en Costo</span>
                    <h4 class="fw-bold mb-0 text-slate-800">RD$ @(((decimal)ViewBag.ValorInventarioCosto).ToString("N2"))</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Stock Bajo</span>
                    <h4 class="fw-bold mb-0 text-slate-800">@ViewBag.BajoStockCount <span class="fs-6 fw-normal text-muted">alertas</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-x-octagon fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Sin Stock / Agotados</span>
                    <h4 class="fw-bold mb-0 text-danger">@ViewBag.AgotadosCount <span class="fs-6 fw-normal text-muted">items</span></h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="sucursalId" class="form-select bg-light fw-semibold" onchange="this.form.submit()">
                <option value="0" selected="@(sucursalSeleccionadaId == 0)">🏢 Todas (Consolidado)</option>
                @foreach (var suc in sucursales)
                {
                    <option value="@suc.Id" selected="@(sucursalSeleccionadaId == suc.Id)">📍 @suc.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="q" value="@filtroQuery" class="form-control bg-light border-start-0" placeholder="Buscar por código, nombre o categoría..." />
            </div>
        </div>
        <div class="col-md-2">
            <select name="categoria" class="form-select bg-light">
                <option value="">Todas las Categorías</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat" selected="@(filtroCategoria == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="estado" class="form-select bg-light">
                <option value="">Todos los Estados</option>
                <option value="normal" selected="@(filtroEstado == "normal")">Stock Normal</option>
                <option value="bajo" selected="@(filtroEstado == "bajo")">Stock Bajo</option>
                <option value="agotado" selected="@(filtroEstado == "agotado")">Agotados (0)</option>
                <option value="inactivo" selected="@(filtroEstado == "inactivo")">Desactivados</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            @if (!string.IsNullOrWhiteSpace(filtroQuery) || !string.IsNullOrWhiteSpace(filtroCategoria) || !string.IsNullOrWhiteSpace(filtroEstado))
            {
                <a asp-action="Index" class="btn btn-light border" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Productos -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-slate-700">
                <tr>
                    <th class="ps-4">CÓDIGO / SKU</th>
                    <th>PRODUCTO & CATEGORÍA</th>
                    <th class="text-end">COSTO</th>
                    <th class="text-end">PRECIO VENTA</th>
                    <th class="text-center">MARGEN</th>
                    <th class="text-center">EXISTENCIA ACTUAL</th>
                    <th class="text-center">ESTADO</th>
                    <th class="text-end pe-4">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-slate-400"></i>
                            No se encontraron productos en el inventario con los filtros aplicados.
                        </td>
                    </tr>
                }
                @foreach (var prod in Model)
                {
                    var stockBadgeClass = prod.StockActual <= 0 
                        ? "bg-danger-subtle text-danger border border-danger-subtle" 
                        : (prod.StockActual <= prod.StockMinimo 
                            ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" 
                            : "bg-success-subtle text-success border border-success-subtle");

                    <tr>
                        <td class="ps-4">
                            <span class="font-monospace fw-bold text-slate-800">@prod.Codigo</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@prod.Descripcion</div>
                            <span class="badge bg-light text-secondary border small">@prod.Categoria</span>
                            <span class="badge bg-light text-muted border small">ITBIS @(prod.IndicadorFacturacion == IndicadorFacturacionType.ITBIS1_18 ? "18%" : prod.IndicadorFacturacion == IndicadorFacturacionType.ITBIS2_16 ? "16%" : "Exento")</span>
                        </td>
                        <td class="text-end text-muted font-monospace">
                            RD$ @prod.CostoUnitario.ToString("N2")
                        </td>
                        <td class="text-end fw-bold text-dark font-monospace">
                            RD$ @prod.PrecioUnitario.ToString("N2")
                        </td>
                        <td class="text-center">
                            <span class="badge @(prod.MargenPorcentaje >= 30 ? "bg-success-subtle text-success" : "bg-light text-muted border") font-monospace">
                                +@prod.MargenPorcentaje%
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge @stockBadgeClass px-2 py-1 fs-6 font-monospace">
                                @prod.StockActual.ToString("0.##")
                            </span>
                            <div class="text-muted" style="font-size: 10px;">Min: @prod.StockMinimo.ToString("0.##")</div>
                        </td>
                        <td class="text-center">
                            @if (prod.EstaActivo)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Desactivado</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group shadow-none">
                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                        onclick="abrirModalAjuste(@prod.Id, '@JavaScriptEncoder.Default.Encode(prod.Descripcion)', @prod.StockActual)"
                                        title="Ajustar Stock / Registrar Entrada">
                                    <i class="bi bi-arrow-left-right"></i>
                                </button>
                                <a asp-action="Editar" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-secondary" title="Editar detalles">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="confirmarEliminar(@prod.Id, '@JavaScriptEncoder.Default.Encode(prod.Descripcion)', @(prod.TieneVentasHistoricas ? "true" : "false"))"
                                        title="@(prod.TieneVentasHistoricas ? "Desactivar de catálogo (ventas asociadas)" : "Eliminar del inventario")">
                                    <i class="bi @(prod.TieneVentasHistoricas ? "bi-eye-slash" : "bi-trash")"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Ajuste Rápido de Stock -->
<div class="modal fade" id="modalAjusteStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="AjustarStock" method="post">
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-slate-800" id="modalAjusteTitulo">
                        <i class="bi bi-arrow-left-right me-2 text-primary"></i>Ajuste de Existencias
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="ProductoId" id="ajusteProductoId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Producto Seleccionado</label>
                        <input type="text" id="ajusteProductoNombre" class="form-control bg-light fw-bold" readonly />
                        <small class="text-muted">Stock actual en sistema: <strong id="ajusteStockActual" class="text-dark">0</strong></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Sucursal / Almacén de Destino</label>
                        <select name="SucursalId" id="ajusteSucursalId" class="form-select fw-semibold" required>
                            @foreach (var suc in sucursales)
                            {
                                <option value="@suc.Id" selected="@(sucursalSeleccionadaId == suc.Id)">📍 @suc.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">No. de Lote (Opcional)</label>
                            <input type="text" name="NumeroLote" class="form-control" placeholder="Ej: LOTE-2026-X" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Vencimiento (Opcional)</label>
                            <input type="date" name="FechaVencimiento" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Tipo de Movimiento</label>
                        <select name="TipoMovimiento" class="form-select" required>
                            <option value="1">Entrada por Compra / Factura Proveedor (+)</option>
                            <option value="4">Ajuste Manual / Conteo Físico (+)</option>
                            <option value="6">Devolución de Venta / Reingreso (+)</option>
                            <option value="2">Salida por Merma / Rotura / Daño (-)</option>
                            <option value="3">Salida por Caducidad / Vencimiento (-)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Cantidad a Ajustar</label>
                        <input type="number" step="0.01" min="0.01" name="Cantidad" class="form-control fw-bold font-monospace" placeholder="Ej: 10" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Motivo o Concepto</label>
                        <input type="text" name="Concepto" class="form-control" placeholder="Ej: Factura Proveedor #1234 / Auditoría de almacén" required />
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-check-circle me-1"></i>Aplicar Ajuste
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Formulario oculto para eliminación segura -->
<form id="formEliminar" asp-action="Eliminar" method="post" class="d-none">
    <input type="hidden" name="id" id="eliminarId" />
</form>

@section Scripts {
    <script>
        function abrirModalAjuste(id, nombre, stock) {
            document.getElementById('ajusteProductoId').value = id;
            document.getElementById('ajusteProductoNombre').value = nombre;
            document.getElementById('ajusteStockActual').innerText = stock;
            new bootstrap.Modal(document.getElementById('modalAjusteStock')).show();
        }

        function confirmarEliminar(id, nombre, tieneVentas) {
            const mensaje = tieneVentas 
                ? `El producto "${nombre}" tiene comprobantes fiscales emitidos ante la DGII.\n\nPor regulaciones tributarias no se puede borrar físicamente para conservar el historial del e-CF, pero será DESACTIVADO del catálogo comercial.\n\n¿Desea desactivarlo?`
                : `¿Está seguro de eliminar definitivamente el producto "${nombre}" del catálogo de inventario? Esta acción no se puede deshacer.`;

            if (confirm(mensaje)) {
                document.getElementById('eliminarId').value = id;
                document.getElementById('formEliminar').submit();
            }
        }
    </script>
}
