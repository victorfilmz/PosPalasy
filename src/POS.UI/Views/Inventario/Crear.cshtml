@model POS.Application.DTOs.CrearProductoDto
@using POS.Domain.Types

@{
    ViewData["Title"] = "Nuevo Producto de Inventario";
    var categorias = ViewBag.CategoriasExistentes as List<string> ?? new List<string>();
    var sucursales = ViewBag.Sucursales as IEnumerable<POS.Domain.Entities.Sucursal> ?? Enumerable.Empty<POS.Domain.Entities.Sucursal>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-light border text-muted"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold text-dark mb-0">Registrar Nuevo Producto</h3>
        </div>
        <p class="text-muted small mb-0 ps-4 ms-2">Complete la información del artículo para incorporarlo al punto de venta y catálogo de existencias</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
            <i class="bi bi-x-circle me-1"></i>Cancelar
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-box-seam me-2 text-primary"></i>Ficha Técnica y Comercial</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear" method="post" id="formCrear">
                    <div class="row g-3">
                        
                        <!-- Código y Generador -->
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-slate-700">Código / Código de Barras (SKU)</label>
                            <div class="input-group">
                                <input type="text" name="Codigo" id="inputCodigo" value="@Model.Codigo" class="form-control font-monospace fw-bold" placeholder="Ej: 746012345678" required />
                                <button type="button" class="btn btn-outline-secondary" onclick="generarCodigo()" title="Generar código automático">
                                    <i class="bi bi-magic"></i>
                                </button>
                            </div>
                            <small class="text-muted">Escanee con pistola de código de barras o genere uno</small>
                        </div>

                        <!-- Categoría -->
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-slate-700">Categoría</label>
                            <input list="listaCategorias" name="Categoria" value="@Model.Categoria" class="form-control" placeholder="Ej: Bebidas, Alimentos, Ferretería..." required />
                            <datalist id="listaCategorias">
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat"></option>
                                }
                            </datalist>
                        </div>

                        <!-- Nombre / Descripción -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-slate-700">Nombre / Descripción Comercial</label>
                            <input type="text" name="Descripcion" value="@Model.Descripcion" class="form-control fw-semibold" placeholder="Ej: Café Santo Domingo Molido 1lb" required />
                            <small class="text-muted">Aparecerá en el ticket impreso y en el catálogo táctil de la caja</small>
                        </div>

                        <!-- Indicador Fiscal DGII -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Indicador Fiscal DGII (ITBIS)</label>
                            <select name="IndicadorFacturacion" class="form-select">
                                <option value="1" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.ITBIS1_18)">Gravado 18% (Tasa general)</option>
                                <option value="2" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.ITBIS2_16)">Gravado 16% (Reducido)</option>
                                <option value="4" selected="@(Model.IndicadorFacturacion == IndicadorFacturacionType.Exento)">Exento de ITBIS (0%)</option>
                            </select>
                        </div>

                        <!-- Unidad de Medida -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Tipo de Bien o Servicio</label>
                            <select class="form-select" disabled>
                                <option>Bien / Mercancía Física</option>
                            </select>
                        </div>

                        <!-- Precios y Costos -->
                        <div class="col-12 pt-3 border-top">
                            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-tag me-2 text-primary"></i>Precios y Rentabilidad</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Costo Unitario de Compra (RD$)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">RD$</span>
                                <input type="number" step="0.01" min="0" name="CostoUnitario" id="inputCosto" value="@Model.CostoUnitario" class="form-control font-monospace" oninput="calcularMargen()" />
                            </div>
                            <small class="text-muted">Costo de adquisición al proveedor (opcional para margen)</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Precio de Venta al Público (RD$)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-primary">RD$</span>
                                <input type="number" step="0.01" min="0.01" name="PrecioUnitario" id="inputPrecio" value="@Model.PrecioUnitario" class="form-control font-monospace fw-bold fs-5 text-primary" oninput="calcularMargen()" required />
                            </div>
                            <small class="text-muted">Precio final facturado en terminal POS</small>
                        </div>

                        <!-- Widget de Margen en Vivo -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-semibold">Rentabilidad Estimada:</span>
                                    <div class="fw-bold" id="labelGanancia">RD$ 0.00 de ganancia bruta</div>
                                </div>
                                <span class="badge bg-secondary px-3 py-2 fs-6" id="badgeMargen">0% Margen</span>
                            </div>
                        </div>

                        <!-- Existencias y Stock -->
                        <div class="col-12 pt-3 border-top">
                            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-boxes me-2 text-primary"></i>Existencias Iniciales</h6>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-slate-700">Sucursal / Almacén de Ingreso Inicial</label>
                            <select name="SucursalId" class="form-select fw-semibold">
                                @foreach (var suc in sucursales)
                                {
                                    <option value="@suc.Id">📍 @suc.Nombre (@suc.CodigoSucursal)</option>
                                }
                            </select>
                            <small class="text-muted">El stock inicial y su apertura en Kardex se registrarán en esta sucursal</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Stock Inicial de Apertura</label>
                            <input type="number" step="0.01" min="0" name="StockInicial" value="@Model.StockInicial" class="form-control font-monospace fw-bold" placeholder="0" />
                            <small class="text-muted">Se registrará automáticamente en el Kardex como entrada inicial</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-slate-700">Umbral de Stock Mínimo de Alerta</label>
                            <input type="number" step="0.01" min="0" name="StockMinimo" value="@Model.StockMinimo" class="form-control font-monospace" placeholder="5" />
                            <small class="text-muted">El sistema alertará en color ámbar cuando queden estas unidades</small>
                        </div>

                        <div class="col-12 mt-2">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="TieneLotes" value="true" id="checkTieneLotes" />
                                <label class="form-check-label fw-semibold text-slate-700" for="checkTieneLotes">
                                    Habilitar rastreo por Número de Lote y Fecha de Vencimiento para este producto
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-bold px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i>Guardar Producto en Inventario
                            </button>
                            <a asp-action="Index" class="btn btn-light border px-4 py-2">Cancelar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function generarCodigo() {
            // Genera código numérico tipo EAN (12 dígitos aleatorios)
            const randomSuffix = Math.floor(100000000 + Math.random() * 900000000);
            document.getElementById('inputCodigo').value = '746' + randomSuffix;
        }

        function calcularMargen() {
            const costo = parseFloat(document.getElementById('inputCosto').value) || 0;
            const precio = parseFloat(document.getElementById('inputPrecio').value) || 0;
            const badge = document.getElementById('badgeMargen');
            const label = document.getElementById('labelGanancia');

            const ganancia = precio - costo;
            label.innerText = `RD$ ${ganancia.toFixed(2)} de ganancia bruta por unidad`;

            if (costo > 0) {
                const margen = ((ganancia / costo) * 100).toFixed(1);
                badge.innerText = `+${margen}% Margen`;
                if (margen >= 30) {
                    badge.className = 'badge bg-success px-3 py-2 fs-6';
                } else if (margen > 0) {
                    badge.className = 'badge bg-warning text-dark px-3 py-2 fs-6';
                } else {
                    badge.className = 'badge bg-danger px-3 py-2 fs-6';
                }
            } else {
                badge.innerText = `100% Margen`;
                badge.className = 'badge bg-primary px-3 py-2 fs-6';
            }
        }

        // Ejecutar al cargar
        document.addEventListener('DOMContentLoaded', calcularMargen);
    </script>
}
