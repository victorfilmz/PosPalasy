@model POS.Domain.Entities.CajaTurno

@{
    ViewData["Title"] = "Arqueo y Cierre de Caja";
    var esperado = Model.EfectivoEsperado;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-lock-fill me-2"></i>Arqueo y Cierre Definitivo de Turno (Reporte Z)</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small d-block">Turno y Operador</span>
                            <span class="fw-bold fs-6">#@Model.Id - @Model.Cajero</span>
                            <small class="text-muted d-block mt-1">Apertura: @Model.FechaApertura.ToLocalTime().ToString("g")</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted small d-block">Total Facturado en el Turno</span>
                            <span class="fw-bold fs-5 text-primary">RD$ @Model.TotalVentas.ToString("N2")</span>
                            <small class="text-muted d-block mt-1">@Model.CantidadTransacciones facturas emitidas</small>
                        </div>
                    </div>
                </div>

                <!-- Resumen de Movimientos de Efectivo -->
                <div class="card bg-light border mb-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Conciliación de Efectivo en Caja</h6>
                        <div class="row g-2 small">
                            <div class="col-6">Fondo Inicial (+):</div>
                            <div class="col-6 text-end fw-bold">RD$ @Model.MontoInicial.ToString("N2")</div>

                            <div class="col-6">Ventas en Efectivo (+):</div>
                            <div class="col-6 text-end fw-bold text-success">+ RD$ @Model.VentasEfectivo.ToString("N2")</div>

                            <div class="col-6">Entradas adicionales (+):</div>
                            <div class="col-6 text-end fw-bold text-success">+ RD$ @Model.TotalEntradasEfectivo.ToString("N2")</div>

                            <div class="col-6">Salidas / Retiros (-):</div>
                            <div class="col-6 text-end fw-bold text-danger">- RD$ @Model.TotalSalidasEfectivo.ToString("N2")</div>

                            <div class="col-12"><hr class="my-1" /></div>

                            <div class="col-6 fs-6 fw-bold text-dark">Efectivo Teórico Esperado:</div>
                            <div class="col-6 text-end fs-5 fw-bold text-primary">RD$ @esperado.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Formulario de Arqueo Físico -->
                <form asp-action="Cierre" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="form-label fw-bold">Efectivo Físico Contado en Caja (RD$)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold">RD$</span>
                            <input type="number" step="0.01" name="montoRealCierre" id="montoRealCierre" class="form-control fw-bold text-end fs-3" 
                                   value="@esperado.ToString("F2")" required oninput="calcularDiferenciaArqueo(@esperado)" />
                        </div>
                        <small class="text-muted">Ingrese el total de billetes y monedas contados físicamente en la gaveta.</small>
                    </div>

                    <!-- Indicador de Diferencia -->
                    <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center border" id="boxDiferencia" style="background-color: #f8fafc;">
                        <span class="fw-bold">Diferencia de Cuadre:</span>
                        <span class="fs-4 fw-bold" id="txtDiferencia">RD$ 0.00 (Cuadrado)</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small">Observaciones o Notas del Cierre (Opcional)</label>
                        <textarea name="observaciones" class="form-control" rows="2" placeholder="Indique justificación en caso de sobrante o faltante de caja..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger fw-bold py-3 fs-5" onclick="return confirm('¿Está seguro de cerrar este turno de caja de manera definitiva?')">
                            <i class="bi bi-lock-fill me-1"></i>Confirmar Arqueo y Generar Reporte Z
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver al Panel de Caja</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function calcularDiferenciaArqueo(esperado) {
        const input = document.getElementById('montoRealCierre');
        const contado = parseFloat(input.value) || 0;
        const diff = Math.round((contado - esperado) * 100) / 100;

        const box = document.getElementById('boxDiferencia');
        const txt = document.getElementById('txtDiferencia');

        if (diff === 0) {
            box.className = "p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center border bg-success-subtle text-success border-success-subtle";
            txt.innerText = "RD$ 0.00 (Caja Cuadrada)";
        } else if (diff > 0) {
            box.className = "p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center border bg-info-subtle text-info-emphasis border-info-subtle";
            txt.innerText = `+ RD$ ${diff.toFixed(2)} (Sobrante)`;
        } else {
            box.className = "p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center border bg-danger-subtle text-danger border-danger-subtle";
            txt.innerText = `- RD$ ${Math.abs(diff).toFixed(2)} (Faltante)`;
        }
    }
</script>
}
