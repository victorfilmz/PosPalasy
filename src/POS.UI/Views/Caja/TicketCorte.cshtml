@model POS.Domain.Entities.CajaTurno
@using POS.Domain.Entities

@{
    Layout = null;
    var enterprise = ViewBag.Enterprise as Enterprise;
    var tipoCorte = ViewBag.TipoCorte as string ?? "X";
    var tituloReporte = ViewBag.TituloReporte as string ?? "CORTE DE CAJA";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte @tipoCorte - Turno #@Model.Id</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Courier New', Courier, monospace, system-ui;
            font-size: 12px;
            color: #000;
            background-color: #f1f5f9;
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .actions-bar {
            width: 100%;
            max-width: 320px;
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        .btn-action {
            flex: 1;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: bold;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            background: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-action.primary {
            background: #0d47a1;
            color: #fff;
            border-color: #0d47a1;
        }
        .ticket-wrapper {
            width: 80mm;
            max-width: 320px;
            background: #fff;
            padding: 16px 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 4px;
        }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .text-start { text-align: left; }
        .fw-bold { font-weight: bold; }
        .uppercase { text-transform: uppercase; }
        .separator {
            border-bottom: 1px dashed #000;
            margin: 8px 0;
        }
        .separator-double {
            border-bottom: 2px solid #000;
            margin: 8px 0;
        }
        .data-table {
            width: 100%;
            font-size: 11px;
            border-collapse: collapse;
        }
        .data-table td {
            padding: 2.5px 0;
        }
        .signature-box {
            margin-top: 25px;
            text-align: center;
            font-size: 10px;
        }
        .signature-line {
            border-top: 1px solid #000;
            width: 80%;
            margin: 0 auto 4px auto;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
                margin: 0;
            }
            .actions-bar {
                display: none !important;
            }
            .ticket-wrapper {
                width: 80mm;
                max-width: 100%;
                box-shadow: none;
                border-radius: 0;
                padding: 4px 2px;
            }
            @@page {
                size: 80mm auto;
                margin: 0mm;
            }
        }
    </style>
</head>
<body>

    <!-- Barra de Botones (Oculta al imprimir) -->
    <div class="actions-bar">
        <button class="btn-action primary" onclick="window.print()">
            <i class="bi bi-printer"></i> Imprimir
        </button>
        <button class="btn-action" onclick="window.close()">
            <i class="bi bi-x-circle"></i> Cerrar
        </button>
    </div>

    <!-- Ticket Térmico 80mm -->
    <div class="ticket-wrapper">
        <!-- Encabezado de la Empresa -->
        <div class="text-center">
            <h3 class="fw-bold uppercase" style="font-size: 14px; margin-bottom: 2px;">
                @(enterprise?.NombreComercial ?? enterprise?.RazonSocial ?? "PosPalasy SRL")
            </h3>
            <div style="font-size: 11px;">RNC: @(enterprise?.RNC ?? "13100000001")</div>
            <div style="font-size: 10px;">@(enterprise?.Direccion ?? "Santo Domingo, República Dominicana")</div>
            <div style="font-size: 10px;">Tel: @(enterprise?.Telefono ?? "809-555-0199")</div>
        </div>

        <div class="separator-double"></div>

        <!-- Título del Corte -->
        <div class="text-center">
            <div class="fw-bold uppercase" style="font-size: 13px;">@tituloReporte</div>
            <div class="fw-bold" style="font-size: 12px; margin-top: 2px;">TURNO #@Model.Id</div>
            <div style="font-size: 10px; color: #444;">
                Impresión: @DateTime.UtcNow.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        </div>

        <div class="separator"></div>

        <!-- Datos del Turno -->
        <table class="data-table">
            <tr>
                <td>Cajero / Operador:</td>
                <td class="text-end fw-bold">@Model.Cajero</td>
            </tr>
            <tr>
                <td>Fecha Apertura:</td>
                <td class="text-end">@Model.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
            @if (Model.FechaCierre.HasValue)
            {
                <tr>
                    <td>Fecha Cierre:</td>
                    <td class="text-end">@Model.FechaCierre.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            <tr>
                <td>Estado del Turno:</td>
                <td class="text-end fw-bold uppercase">@Model.Estado</td>
            </tr>
        </table>

        <div class="separator"></div>

        <!-- Desglose de Ventas por Método de Pago -->
        <div class="fw-bold uppercase mb-1" style="font-size: 11px;">VENTAS POR FORMA DE PAGO</div>
        <table class="data-table">
            <tr>
                <td>Efectivo (01):</td>
                <td class="text-end fw-bold">RD$ @Model.VentasEfectivo.ToString("N2")</td>
            </tr>
            <tr>
                <td>Tarjetas Débito/Crédito (03):</td>
                <td class="text-end fw-bold">RD$ @Model.VentasTarjeta.ToString("N2")</td>
            </tr>
            <tr>
                <td>Transferencias (04):</td>
                <td class="text-end fw-bold">RD$ @Model.VentasTransferencia.ToString("N2")</td>
            </tr>
            <tr style="border-top: 1px dashed #000;">
                <td class="fw-bold" style="padding-top: 4px;">TOTAL VENTAS FACTURADAS:</td>
                <td class="text-end fw-bold" style="padding-top: 4px;">RD$ @Model.TotalVentas.ToString("N2")</td>
            </tr>
            <tr>
                <td style="font-size: 10px; color: #444;">Comprobantes Emitidos:</td>
                <td class="text-end" style="font-size: 10px;">@Model.CantidadTransacciones</td>
            </tr>
        </table>

        <div class="separator"></div>

        <!-- Arqueo de Efectivo Físico -->
        <div class="fw-bold uppercase mb-1" style="font-size: 11px;">CONCILIACIÓN DE EFECTIVO EN CAJA</div>
        <table class="data-table">
            <tr>
                <td>(+) Fondo Inicial:</td>
                <td class="text-end">RD$ @Model.MontoInicial.ToString("N2")</td>
            </tr>
            <tr>
                <td>(+) Ventas en Efectivo:</td>
                <td class="text-end">RD$ @Model.VentasEfectivo.ToString("N2")</td>
            </tr>
            <tr>
                <td>(+) Entradas de Efectivo:</td>
                <td class="text-end">RD$ @Model.TotalEntradasEfectivo.ToString("N2")</td>
            </tr>
            <tr>
                <td>(-) Salidas de Efectivo:</td>
                <td class="text-end">RD$ @Model.TotalSalidasEfectivo.ToString("N2")</td>
            </tr>
            <tr style="border-top: 1px dashed #000;">
                <td class="fw-bold">(=) Efectivo Esperado:</td>
                <td class="text-end fw-bold">RD$ @Model.EfectivoEsperado.ToString("N2")</td>
            </tr>
            @if (tipoCorte == "Z" || Model.MontoRealCierre.HasValue)
            {
                var diff = Model.Diferencia ?? 0;
                var diffText = diff == 0 ? "CUADRADO (0.00)" :
                               diff > 0 ? $"+RD$ {diff:N2} (SOBRANTE)" :
                               $"-RD$ {Math.Abs(diff):N2} (FALTANTE)";

                <tr>
                    <td class="fw-bold">Efectivo Físico Contado:</td>
                    <td class="text-end fw-bold">RD$ @(Model.MontoRealCierre?.ToString("N2") ?? "0.00")</td>
                </tr>
                <tr style="font-size: 12px; border-top: 1px solid #000;">
                    <td class="fw-bold" style="padding-top: 4px;">DIFERENCIA:</td>
                    <td class="text-end fw-bold" style="padding-top: 4px;">@diffText</td>
                </tr>
            }
        </table>

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="separator"></div>
            <div style="font-size: 10px;">
                <span class="fw-bold">Observaciones:</span> @Model.Observaciones
            </div>
        }

        <div class="separator-double"></div>

        <!-- Firmas de Responsabilidad -->
        <div class="signature-box" style="margin-top: 30px;">
            <div class="signature-line"></div>
            <div>@Model.Cajero</div>
            <div style="font-size: 9px; color: #555;">Firma del Cajero</div>
        </div>

        <div class="signature-box" style="margin-top: 25px;">
            <div class="signature-line"></div>
            <div>Supervisor / Administrador</div>
            <div style="font-size: 9px; color: #555;">Firma de Conformidad</div>
        </div>

        <div class="text-center" style="font-size: 9px; color: #666; margin-top: 15px;">
            PosPalasy DGII | Documento de Control Interno
        </div>
    </div>
</body>
</html>
