@model POS.Application.DTOs.ElectronicInvoiceRequest
@using POS.Domain.Types

@{
    ViewData["Title"] = "Emitir Factura Electrónica e-CF";
}

<div class="mb-4">
    <h2 class="fw-bold mb-0">Emitir Factura Electrónica e-CF</h2>
    <p class="text-muted">Generación, firma XML-DSig y envío directo a la DGII de República Dominicana</p>
</div>

<form asp-action="Emitir" method="post">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <div class="row g-4">
        <!-- Emisor y Comprobante -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-building me-2"></i>Datos del Emisor y Comprobante</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tipo de e-CF</label>
                            <select class="form-select" asp-for="TipoeCF">
                                <option value="32">Tipo 32 - Factura de Consumo</option>
                                <option value="31">Tipo 31 - Factura de Crédito Fiscal</option>
                                <option value="33">Tipo 33 - Nota de Débito</option>
                                <option value="34">Tipo 34 - Nota de Crédito</option>
                                <option value="41">Tipo 41 - Compras</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">eNCF (13 caracteres)</label>
                            <input class="form-control font-monospace" asp-for="eNCF" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">RNC Emisor</label>
                            <input class="form-control font-monospace" asp-for="Emisor.RNC" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Razón Social</label>
                            <input class="form-control" asp-for="Emisor.RazonSocial" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Dirección</label>
                            <input class="form-control" asp-for="Emisor.Direccion" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Comprador -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-success"><i class="bi bi-person me-2"></i>Datos del Comprador</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">RNC / Cédula (Opcional)</label>
                            <input class="form-control font-monospace" asp-for="Comprador.RNC" placeholder="9 u 11 dígitos" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Razón Social / Nombre</label>
                            <input class="form-control" asp-for="Comprador.RazonSocial" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Dirección Comprador</label>
                            <input class="form-control" asp-for="Comprador.Direccion" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Teléfono</label>
                            <input class="form-control" asp-for="Comprador.Telefono" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Correo Electrónico</label>
                            <input class="form-control" type="email" asp-for="Comprador.Email" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items de la Factura -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-cart3 me-2"></i>Detalle de Productos / Items</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Descripción</th>
                                    <th style="width: 120px;">Cantidad</th>
                                    <th style="width: 150px;">Precio Unit. (DOP)</th>
                                    <th style="width: 180px;">Indicador ITBIS</th>
                                    <th style="width: 120px;">Descuento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input class="form-control" asp-for="Items[i].Descripcion" required />
                                            <input type="hidden" asp-for="Items[i].Indice" value="@(i + 1)" />
                                        </td>
                                        <td>
                                            <input class="form-control" type="number" step="0.01" min="0.01" asp-for="Items[i].Cantidad" required />
                                        </td>
                                        <td>
                                            <input class="form-control" type="number" step="0.01" min="0.01" asp-for="Items[i].PrecioUnitario" required />
                                        </td>
                                        <td>
                                            <select class="form-select" asp-for="Items[i].IndicadorFacturacion">
                                                <option value="1">18% - Gravado General</option>
                                                <option value="2">16% - Primera Necesidad</option>
                                                <option value="4">Exento (0%)</option>
                                                <option value="0">No Facturable 18%</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input class="form-control" type="number" step="0.01" min="0" asp-for="Items[i].Descuento" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Los impuestos y totales se calcularán de acuerdo a la normativa DGII.</span>
                    <button type="submit" class="btn btn-success btn-lg px-4">
                        <i class="bi bi-send-check me-2"></i>Emitir y Enviar a DGII
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
