@model POS.Domain.Entities.ElectronicInvoice
@using POS.Domain.Enums
@using POS.Domain.Types

@{
    ViewData["Title"] = "Detalle Factura " + Model.eNCF;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Comprobante @Model.eNCF</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-tabular">
                @(Model.TipoeCF switch
                {
                    TipoeCFType.FacturaCreditoFiscal => "e-CF 31 Crédito Fiscal",
                    TipoeCFType.FacturaConsumo => "e-CF 32 Consumo",
                    TipoeCFType.NotaDebito => "e-CF 33 Nota de Débito",
                    TipoeCFType.NotaCredito => "e-CF 34 Nota de Crédito",
                    _ => Model.TipoeCF.ToString()
                })
            </span>
        </div>
        <p class="text-muted small mb-0 font-tabular">
            Fecha Emisión: @Model.FechaEmision • Emisor RNC: @Model.RNCEmisor (@Model.RazonSocialEmisor)
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (!string.IsNullOrEmpty(Model.TrackId))
        {
            <form asp-action="ConsultarEstado" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-primary fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-clockwise"></i>Consultar Estado DGII
                </button>
            </form>
        }
        @if (Model.Estado == EstadoFacturaElectronica.PendienteReenvio)
        {
            <form asp-action="Reenviar" asp-route-encf="@Model.eNCF" method="post" class="d-inline">
                <button type="submit" class="btn btn-warning fw-bold d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-cloud-arrow-up"></i>Reenviar a DGII
                </button>
            </form>
        }
        <a asp-controller="Pos" asp-action="Ticket" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark fw-semibold d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-printer"></i>Imprimir Ticket Térmico
        </a>
        @if (Model.Estado != EstadoFacturaElectronica.Anulado)
        {
            <button type="button" class="btn btn-outline-danger fw-semibold d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalAnular">
                <i class="bi bi-x-circle"></i>Anular e-CF (ANECF)
            </button>
        }
        <a asp-action="Lista" class="btn btn-light border fw-semibold">Volver al listado</a>
    </div>
</div>

@if (Model.TipoeCF == TipoeCFType.NotaCredito && !string.IsNullOrEmpty(Model.eNCFModificado))
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-warning-subtle">
        <div class="card-body px-4 py-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-arrow-return-left me-2"></i>Nota de crédito — corrige al comprobante
                </h6>
                <span class="badge bg-dark font-tabular">@Model.eNCFModificado</span>
                @if (!string.IsNullOrEmpty(Model.FechaNCFModificado))
                {
                    <span class="text-muted small">fecha del comprobante modificado: @Model.FechaNCFModificado</span>
                }
                @if (Model.CodigoModificacion.HasValue)
                {
                    var motivo = Model.CodigoModificacion.Value switch
                    {
                        1 => "anulación",
                        2 => "corrección de texto",
                        3 => "corrección de montos",
                        4 => "sustitución",
                        _ => string.Empty
                    };
                    <span class="badge bg-secondary">
                        Código de modificación: @Model.CodigoModificacion@(!string.IsNullOrEmpty(motivo) ? $" ({motivo})" : string.Empty)
                    </span>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Resumen y Trazabilidad -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-shield-check me-2 text-primary"></i>Trazabilidad DGII</h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted small d-block fw-bold">Estado Fiscal</span>
                    <span class="fs-6 fw-bold">
                        @switch (Model.Estado)
                        {
                            case EstadoFacturaElectronica.Aceptado:
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                    <i class="bi bi-check2-circle me-1"></i>Aceptado DGII
                                </span>
                                break;
                            case EstadoFacturaElectronica.EnProceso:
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-2">
                                    <i class="bi bi-hourglass-split me-1"></i>En Proceso
                                </span>
                                break;
                            case EstadoFacturaElectronica.Rechazado:
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                    <i class="bi bi-x-circle me-1"></i>Rechazado
                                </span>
                                break;
                            case EstadoFacturaElectronica.PendienteReenvio:
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
                                    <i class="bi bi-cloud-slash me-1"></i>Contingencia Local
                                </span>
                                break;
                            default:
                                <span class="badge bg-light text-dark">@Model.Estado</span>
                                break;
                        }
                    </span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block fw-bold">TrackId (Seguimiento DGII)</span>
                    <code class="fs-6 text-dark font-monospace">@(string.IsNullOrEmpty(Model.TrackId) ? "No asignado (Offline)" : Model.TrackId)</code>
                </div>

                @if (!string.IsNullOrEmpty(Model.EstadoDgii))
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block fw-bold">Estado Reportado por la DGII</span>
                        <span class="fs-6 fw-bold">@Model.EstadoDgii</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MensajesDgii))
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block fw-bold">Mensajes de la DGII</span>
                        <span class="small text-dark">@Model.MensajesDgii</span>
                    </div>
                }

                @if (Model.SecuenciaUtilizada.HasValue)
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block fw-bold">Secuencia del e-NCF</span>
                        @if (Model.SecuenciaUtilizada.Value)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Consumida (no reutilizable)</span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Puede reutilizarse</span>
                        }
                    </div>
                }

                <div class="mb-3">
                    <span class="text-muted small d-block fw-bold">Código de Seguridad (Hash 6 chars)</span>
                    <code class="fs-5 text-primary fw-bold font-monospace">@Model.XMLHash</code>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block fw-bold">Fecha de Envío</span>
                    <span class="font-tabular text-muted">@(Model.FechaEnvio.HasValue ? Model.FechaEnvio.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "Sin transmitir")</span>
                </div>

                @if (Model.FechaAprobacion.HasValue)
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block fw-bold">Fecha de Aprobación DGII</span>
                        <span class="text-success fw-bold font-tabular">@Model.FechaAprobacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
                {
                    <div class="alert alert-danger mb-0 small">
                        <strong>Motivo de Rechazo:</strong><br />
                        @Model.MotivoRechazo
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Totales e Impuestos -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-calculator me-2 text-success"></i>Totales y Desglose Fiscal</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="metric-card metric-card-primary">
                            <span class="text-muted small d-block text-uppercase fw-bold">Base Gravada 18%</span>
                            <div class="fs-5 fw-bold text-dark font-tabular my-1">RD$ @Model.MontoGravadoI1.ToString("N2")</div>
                            <small class="text-muted font-tabular">ITBIS 18%: RD$ @Model.TotalITBIS1.ToString("N2")</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="metric-card metric-card-amber">
                            <span class="text-muted small d-block text-uppercase fw-bold">Base Gravada 16%</span>
                            <div class="fs-5 fw-bold text-dark font-tabular my-1">RD$ @Model.MontoGravadoI2.ToString("N2")</div>
                            <small class="text-muted font-tabular">ITBIS 16%: RD$ @Model.TotalITBIS2.ToString("N2")</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="metric-card metric-card-emerald">
                            <span class="text-muted small d-block text-uppercase fw-bold">Monto Exento</span>
                            <div class="fs-5 fw-bold text-dark font-tabular my-1">RD$ @Model.MontoExento.ToString("N2")</div>
                            <small class="text-muted">Tasa 0% según ley</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="metric-card metric-card-purple">
                            <span class="text-muted small d-block text-uppercase fw-bold">Impuesto Adicional ISC</span>
                            <div class="fs-5 fw-bold text-dark font-tabular my-1">RD$ @Model.MontoImpuestoAdicional.ToString("N2")</div>
                            <small class="text-muted">Selectivo al consumo</small>
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                        <div class="p-4 rounded-4 d-flex justify-content-between align-items-center" style="background-color: #eff6ff; border: 1px solid #bfdbfe;">
                            <div>
                                <span class="small fw-bold text-uppercase d-block text-primary">Total Facturado (DOP)</span>
                                <small class="text-muted font-tabular">Total ITBIS devengado: RD$ @Model.TotalITBIS.ToString("N2")</small>
                            </div>
                            <span class="fs-2 fw-bold text-primary font-tabular">RD$ @Model.MontoTotal.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido XML -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-code-square me-2 text-primary"></i>XML Oficial e-CF con Firma Digital XML-DSig</h6>
                <span class="badge bg-secondary-subtle text-secondary border font-tabular">UTF-8 • Conforme DGII</span>
            </div>
            <div class="card-body p-0">
                <pre class="bg-dark text-light p-4 mb-0 font-monospace small" style="max-height: 420px; overflow-y: auto;"><code>@Model.XMLContent</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ANULACIÓN ANECF -->
<div class="modal fade" id="modalAnular" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Anular" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white py-3 px-4">
                    <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i>Anular e-CF @Model.eNCF</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning small">
                        <strong>Atención:</strong> La anulación generará un XML oficial <code>ANECF</code> conforme al estándar DGII y transmitirá la revocación inmediata del e-NCF.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-slate-700">Código de Motivo de Anulación (DGII)</label>
                        <select name="codigoMotivo" class="form-select" required>
                            <option value="1">1 - Deterioro de factura</option>
                            <option value="2">2 - Extravío de factura</option>
                            <option value="3">3 - Error de impresión / datos</option>
                            <option value="4">4 - Omisión de emisión</option>
                            <option value="5" selected>5 - Devolución de productos / Corrección de venta</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-slate-700">Justificación detallada del motivo</label>
                        <textarea name="motivo" class="form-control" rows="3" placeholder="Indique la razón específica de la revocación..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold d-flex align-items-center gap-2 px-4 shadow-sm">
                        <i class="bi bi-shield-x"></i>Confirmar y Transmitir ANECF
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
